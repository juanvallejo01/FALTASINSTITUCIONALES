# Base de datos PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/faltas_institucionales"

# Secreto para firmar JWT de sesión (mínimo 32 caracteres aleatorios).
# Generar con: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION"

# Zona horaria de la aplicación
APP_TIMEZONE="America/Bogota"

# Entorno
NODE_ENV="development"
