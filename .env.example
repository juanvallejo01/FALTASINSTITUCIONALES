# Copia este archivo como .env para desarrollo local. NUNCA subas el .env a git.
# En Vercel estas variables se configuran en Project → Settings → Environment Variables.

# Base de datos PostgreSQL.
# Local: postgresql://USUARIO@127.0.0.1:5432/faltas_institucionales
# Vercel + Neon: usa la cadena "pooled" (con -pooler en el host) y agrega
# "&pgbouncer=true" al final para que Prisma funcione con el pool de conexiones.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/faltas_institucionales"

# Secreto para firmar las sesiones (JWT). En producción: mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION"

# Zona horaria de la aplicación (define qué es "hoy" para la asistencia)
APP_TIMEZONE="America/Bogota"

# Mostrar las cuentas DEMO en /login (siempre se muestran en desarrollo).
# En producción solo se muestran si vale "true". Útil para un despliegue de
# pruebas; nunca activarlo con datos reales.
SHOW_DEMO_LOGIN=

# Nota: NODE_ENV no se configura a mano. Next.js y Vercel lo definen solos
# ("development" con npm run dev, "production" en npm run build/start y en Vercel).
